# ---- database ----------------------------------------------------------
# Local dev:  npm run dev:db   (PGlite, no Docker needed)
DATABASE_URL=postgres://hue:hue@localhost:5432/hue_studio
# The PGlite dev server accepts 10 connections; the pool stays under that.
# DB_POOL_MAX=10

# ---- app ---------------------------------------------------------------
APP_URL=http://localhost:3000
SESSION_COOKIE_NAME=hue_studio_session
SESSION_TTL_DAYS=14
# How long an invite / password-reset link stays valid.
INVITE_TTL_DAYS=7

# Default timezone for a client created without one.
DEFAULT_TIMEZONE=Africa/Cairo
# Default locale: ar or en.
DEFAULT_LOCALE=ar

# ---- email -------------------------------------------------------------
# Without a key, every send is recorded in email_log and skipped, so local
# development never blocks on it. Get one at resend.com.
RESEND_API_KEY=
EMAIL_FROM=HUE Studio <studio@huecreative.agency>
# Where "a new request arrived" notifications go.
ADMIN_EMAIL=

# ---- media -------------------------------------------------------------
# Client logos and moodboard files. Deliverables are Drive links, not uploads.
MEDIA_ROOT=./.media
MEDIA_URL=http://localhost:3000/media
MEDIA_MAX_MB=25

# ---- worker ------------------------------------------------------------
# WORKER_TICK_MS=60000
# WORKER_BATCH=5
# WORKER_LEASE_SECONDS=300
